prototype(ISP.BasicStructure:OnePage) < prototype(Neos.Neos:Page) {

  htmlTag = Neos.Fusion:Tag {
    @position = 'start'
    tagName = 'html'
    omitClosingTag = true

    attributes {

            style = Neos.Fusion:Case {
                orangeCon {
                        condition = ${q(node).property('color') == 'orange'}
                        renderer = ${'--primary-color: #FF921C; --custom-btn-bg-hover-color: #FF921C; --secondary-color: #ECA427; --section-bg-color: #ECA427; --site-footer-bg-color: #FF921C;'}
                }
                fuchsiaCon {
                        condition = ${q(node).property('color') == 'fuchsia'}
                        renderer = ${'--primary-color: #D8125B; --custom-btn-bg-hover-color: #D8125B; --secondary-color: #2C2E39; --section-bg-color: #2C2E39; --site-footer-bg-color: #D8125B;'}
                }
                greenCon {
                        condition = ${q(node).property('color') == 'green'}
                        renderer = ${'--primary-color: #205A28; --custom-btn-bg-hover-color: #205A28; --secondary-color: #C72B32; --section-bg-color: #FFFFFF; --site-footer-bg-color: #205A28;'}
                }
                pinkCon {
                        condition = ${q(node).property('color') == 'pink'}
                        renderer = ${'--primary-color: #FF78AC; --custom-btn-bg-hover-color: #FF78AC; --secondary-color: #A8D5E3; --section-bg-color: #F2F0EA; --site-footer-bg-color: #FF78AC;'}
                }
                creamCon {
                        condition = ${q(node).property('color') == 'cream'}
                        renderer = ${'--primary-color: #FFFDF2; --custom-btn-bg-hover-color: #000000; --secondary-color: #000000; --section-bg-color: #FFFDF2; --site-footer-bg-color: #000000;'}
                }
                jungleCon {
                        condition = ${q(node).property('color') == 'jungle'}
                        renderer = ${'--primary-color: #009B4D; --custom-btn-bg-hover-color: #009B4D; --secondary-color: #FFCC00; --section-bg-color: #FAF5E9; --site-footer-bg-color: #009B4D;'}
                }
            }
    }
  }

    imageUri = Neos.Neos:ImageUri {
        asset = ${q(node).property('image')}
        maximumWidth = 1920
        maximumHeight = 1080
        @if.image = ${q(node).property('image')}
    }
    head {
        stylesheets.site = Neos.Fusion:Template {
            templatePath = 'resource://ISP.BasicStructure/Private/Templates/Page/OnePage.html'
            sectionName = 'stylesheets'
        }
        javascripts.site = Neos.Fusion:Template {
            templatePath = 'resource://ISP.BasicStructure/Private/Templates/Page/OnePage.html'
            sectionName = 'headScripts'
        }
    }
    body {

        cr = ${q(node).property('cr')}
        logo = Neos.Fusion:ResourceUri {
            resource = ${q(node).property('logo').resource}
        }

        templatePath = 'resource://ISP.BasicStructure/Private/Templates/Page/OnePage.html'
        sectionName = 'body'
        imageUri = Neos.Neos:ImageUri {
            asset = ${q(node).property('image')}
            maximumWidth = 1920
            maximumHeight = 1080
            @if.image = ${q(node).property('image')}
        }
        parts {
            breadcrumb = Neos.Neos:BreadcrumbMenu
            menu = Neos.Neos:Menu {
                entryLevel = 1
                templatePath = 'resource://ISP.BasicStructure/Private/Templates/FusionObjects/MainMenu.html'
                maximumLevels = 1
                site = ${site}
            }
        }
        content {
            // The default content section
            main = Neos.Neos:PrimaryContent {
                nodePath = 'main'
            }
            slider = Neos.Neos:ContentCollection {
                nodePath = 'slider'
            }
            content = Neos.Neos:ContentCollection {
                nodePath = 'content'
            }
            content2 = Neos.Neos:ContentCollection {
                nodePath = 'content2'
            }
            content3 = Neos.Neos:ContentCollection {
                nodePath = 'content3'
            }
            content4 = Neos.Neos:ContentCollection {
                nodePath = 'content4'
            }
            footer = Neos.Neos:ContentCollection {
                nodePath = 'footer'
            }
            TopContact = Neos.Neos:ContentCollection {
                nodePath = 'TopContact'
            }
        }
        javascripts.site = Neos.Fusion:Template {
            templatePath = 'resource://ISP.BasicStructure/Private/Templates/Page/OnePage.html'
            sectionName = 'bodyScripts'
        }
    }
}
